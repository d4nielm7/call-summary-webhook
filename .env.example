# Shared secret used to sign webhook bodies (HMAC-SHA256). Generate one with:
#   openssl rand -hex 32
WEBHOOK_SECRET=change-me

# Turns on the dashboard at / and its data API. Leave unset to keep both switched off.
# The dashboard shows caller details, so use a long random value:  openssl rand -hex 24
# DASHBOARD_TOKEN=change-me-to-something-long

# The timezone the dashboard counts days and hours in (IANA name). Defaults to America/New_York.
# DASHBOARD_TZ=America/New_York

# Where the SQLite file lives. Defaults to ./data/calls.db
# DATABASE_PATH=./data/calls.db

# Defaults to 3000
# PORT=3000
