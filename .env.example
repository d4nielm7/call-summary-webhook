# Shared secret the receptionist platform uses to sign request bodies (min 16 characters).
# openssl rand -hex 32
WEBHOOK_SECRET=

# Turns on the dashboard and its data API. Leave empty to keep both off.
# openssl rand -hex 24
DASHBOARD_TOKEN=

# Timezone the dashboard counts days and hours in. Defaults to America/New_York.
DASHBOARD_TZ=

# SQLite file. Defaults to ./data/calls.db
DATABASE_PATH=
